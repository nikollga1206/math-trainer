errors = []


def fail(msg):
    errors.append(msg)


def check_common(t, topic):
    if t["topicId"] != topic:
        fail(f"{topic}: неверный topicId {t['topicId']}")
    if not t.get("subtype") or not t.get("text") or not t.get("explanation"):
        fail(f"{topic}: пустое поле в {t}")
    ans = t["answer"]
    if isinstance(ans, list):
        # Задание со временем: массив допустимых строк «Ч:ММ»
        if t["subtype"] != "clock":
            fail(f"{topic}: массив ответов вне подтипа clock: {t['text']}")
        if not t.get("inputColon"):
            fail(f"{topic}: clock без inputColon: {t['text']}")
        if len(ans) < 1:
            fail(f"{topic}: пустой массив ответов: {t['text']}")
        for a in ans:
            if not re.match(r"^\d{1,2}:\d{2}$", a):
                fail(f"{topic}: недопустимый ответ времени {a!r} в {t['text']}")
    elif isinstance(ans, str):
        if ans not in (">", "<", "="):
            fail(f"{topic}: недопустимый строковый ответ {ans!r} в {t['text']}")
    else:
        if not float(ans).is_integer():
            fail(f"{topic}: нецелый ответ {ans} в {t['text']}")
        if ans < 0:
            fail(f"{topic}: отрицательный ответ {ans} в {t['text']}")
    if "unitOptions" in t and t["unitOptions"] is not None:
        if t.get("answerUnit") not in t["unitOptions"]:
            fail(f"{topic}: answerUnit не из unitOptions в {t['text']}")


def check_mul_limit(text, topic):
    """Пункт 5: каждое умножение — произведение ≤ 81 либо множитель 10/100/1000."""
    for a, b in re.findall(r"(\d+) × (\d+)", text):
        a, b = int(a), int(b)
        if a * b > 81 and a not in (10, 100, 1000) and b not in (10, 100, 1000):
            fail(f"{topic}: умножение за пределами таблицы {a} × {b} в {text}")
    # Случай '(a + b) × c': проверяем сумму × c
    m = re.search(r"\((\d+) \+ (\d+)\) × (\d+)", text)
    if m:
        s, c = int(m.group(1)) + int(m.group(2)), int(m.group(3))
        if s * c > 81:
            fail(f"{topic}: ({m.group(1)} + {m.group(2)}) × {c} = {s * c} > 81 в {text}")


def js_eval_expr(expr):
    # Вычисляет арифметическое выражение с × ÷ −, проверяя целочисленность делений
    e = expr.replace("×", "*").replace("÷", "/").replace("−", "-")
    tokens = re.findall(r"\d+|[()+\-*/]", e)
    # Простая проверка: все деления нацело — вычисляем через Fraction
    from fractions import Fraction
    py = e
    # заменяем числа на Fraction
    py = re.sub(r"\d+", lambda m: f"F({m.group(0)})", py)
    F = Fraction
    val = eval(py)  # выражение из нашего же генератора, безопасно
    return val


def check_arith(t, topic):
    """Проверка примеров вида '<выражение> = ?' и пропусков."""
    text = t["text"]
    m = re.match(r"^(.+) = \?$", text)
    if m:
        val = js_eval_expr(m.group(1))
        if val.denominator != 1:
            fail(f"{topic}: нецелый результат {val} в {text}")
        if int(val) != t["answer"]:
            fail(f"{topic}: answer={t['answer']} != {val} в {text}")
        return
    m = re.match(r"^(\d+) × _ = (\d+)$", text)
    if m:
        a, c = int(m.group(1)), int(m.group(2))
        if c % a != 0 or c // a != t["answer"]:
            fail(f"{topic}: пропуск неверен в {text}, answer={t['answer']}")
        return
    m = re.match(r"^_ × (\d+) = (\d+)$", text)
    if m:
        b, c = int(m.group(1)), int(m.group(2))
        if c % b != 0 or c // b != t["answer"]:
            fail(f"{topic}: пропуск неверен в {text}, answer={t['answer']}")
        return
    fail(f"{topic}: нераспознанный текст {text}")


def check_units_convert(t, table, topic):
    # Текст: 'N ед = _ ?' (unitOptions) или 'N ед = _ ед2'
    m = re.match(r"^(\d+) (\S+) = _ (\?|\S+)$", t["text"])
    if not m:
        fail(f"{topic}: нераспознанный convert {t['text']}")
        return
    n, u_from = int(m.group(1)), m.group(2)
    u_to = t.get("answerUnit") or m.group(3)
    expected = n * table[u_from] // table[u_to]
    if n * table[u_from] % table[u_to] != 0 or expected != t["answer"]:
        fail(f"{topic}: convert неверен {t['text']} answer={t['answer']}, ожидалось {expected} {u_to}")


def check_units_compare(t, table, topic):
    m = re.match(r"^(\d+) (\S+) _ (\d+) (\S+)$", t["text"])
    if not m:
        fail(f"{topic}: нераспознанный compare {t['text']}")
        return
    v1, u1, v2, u2 = int(m.group(1)), m.group(2), int(m.group(3)), m.group(4)
    left, right = v1 * table[u1], v2 * table[u2]
    sign = ">" if left > right else "<" if left < right else "="
    if sign != t["answer"]:
        fail(f"{topic}: compare неверен {t['text']} answer={t['answer']}, верно {sign}")


def check_units_calc(t, table, topic):
    m = re.match(r"^(\d+) (\S+) (\d+) (\S+) ([+−]) (\d+) (\S+) = _ (\S+)$", t["text"])
    if not m:
        fail(f"{topic}: нераспознанный calc {t['text']}")
        return
    n1, ub, s1, us, op, s2, us2, ures = m.groups()
    total = int(n1) * table[ub] + int(s1) * table[us]
    total = total + int(s2) * table[us2] if op == "+" else total - int(s2) * table[us2]
    if total < 0:
        fail(f"{topic}: отрицательный calc {t['text']}")
    if total // table[ures] != t["answer"] or total % table[ures] != 0:
        fail(f"{topic}: calc неверен {t['text']} answer={t['answer']}, верно {total // table[ures]}")


def check_time_composite(t):
    # Составной перевод: '1 ч 20 мин = _ мин'
    m = re.match(r"^(\d+) (\S+) (\d+) (\S+) = _ (\S+)$", t["text"])
    if not m:
        fail(f"time: нераспознанный составной convert {t['text']}")
        return
    n, ub, s, us, ures = m.groups()
    expected = (int(n) * TIME[ub] + int(s) * TIME[us]) // TIME[ures]
    if expected != t["answer"]:
        fail(f"time: составной convert неверен {t['text']} answer={t['answer']}, верно {expected}")


# Названия часов для пересчёта словесных формулировок
HOUR_WORDS = ['двенадцать', 'один', 'два', 'три', 'четыре', 'пять', 'шесть',
              'семь', 'восемь', 'девять', 'десять', 'одиннадцать']


def check_clock(t, level):
    ans = t["answer"]
    h, m = map(int, ans[0].split(":"))
    if not (0 <= h <= 23 and 0 <= m <= 59):
        fail(f"time clock: недопустимое время {ans[0]}")
    # Второй допустимый ответ — тот же момент в другом формате (12/24 ч)
    h2, m2 = map(int, ans[1].split(":"))
    if m2 != m or (h2 - h) % 12 != 0 or h2 == h:
        fail(f"time clock: пара ответов {ans} не о одном времени")
    # Кратность минут уровню
    allowed = {"easy": {0, 30}, "medium": {0, 15, 30, 45}, "hard": set(range(0, 60, 5))}[level]
    if m not in allowed:
        fail(f"time clock {level}: минуты {m} не из {sorted(allowed)} ({ans[0]})")
    text = t["text"]
    if "<svg" in text:
        # Формат «циферблат → цифры»: стрелки есть, текст словами не содержится
        if "половина" in text or "четверть" in text or "ровно" in text:
            fail(f"time clock: svg-задание со словесной формулировкой: {text[:60]}")
        return
    # Словесная формулировка: пересчитываем и сверяем с ответом
    if level == "easy":
        fail(f"time clock easy: словесная формулировка не предусмотрена: {text[:60]}")
    if "без четверти" in text:
        exp_m, kind = 45, "без четверти"
    elif "половина" in text:
        exp_m, kind = 30, "половина"
    elif "четверть" in text:
        exp_m, kind = 15, "четверть"
    elif "ровно" in text:
        exp_m, kind = 0, "ровно"
    else:
        mm = re.search(r"без (\d+) минут", text)
        if not mm:
            fail(f"time clock: нераспознанная формулировка {text[:60]}")
            return
        exp_m, kind = 60 - int(mm.group(1)), "без N минут"
    if m != exp_m:
        fail(f"time clock: «{kind}» != {m} мин в {text[:60]} (ответ {ans[0]})")
    # «без N минут» — только N из {5,10,15,20,25}
    if kind == "без N минут" and (60 - m) not in (5, 10, 15, 20, 25):
        fail(f"time clock: N={60 - m} не из {{5,10,15,20,25}}: {text[:60]}")
    # Час в формулировке согласован с ответом
    for i, w in enumerate(HOUR_WORDS):
        if re.search(rf"\b{w}\b", text):
            if kind in ("ровно",):
                exp_h = i % 12
            else:
                exp_h = (i - 1) % 12
            if h % 12 != exp_h:
                fail(f"time clock: час «{w}» != {h} в {text[:60]} (ответ {ans[0]})")
            break
    # Пояснение содержит разбор
    if "=" not in t["explanation"]:
        fail(f"time clock: нет разбора в пояснении: {t['explanation']}")


def check_geometry(t):
    text = t["text"]
    if t["subtype"] == "perimeter":
        m = re.match(r"^Сторона квадрата (\d+) см\.", text)
        if m:
            exp = 4 * int(m.group(1))
        else:
            m = re.match(r"^Длина прямоугольника (\d+) см, ширина (\d+) см\.", text)
            exp = 2 * (int(m.group(1)) + int(m.group(2)))
        if t["answer"] != exp or t.get("unit") != "см":
            fail(f"geometry: perimeter неверен {text} answer={t['answer']}, верно {exp}")
    elif t["subtype"] == "area":
        m = re.match(r"^Сторона квадрата (\d+) см\.", text)
        if m:
            exp = int(m.group(1)) ** 2
        else:
            m = re.match(r"^Длина прямоугольника (\d+) см, ширина (\d+) см\.", text)
            exp = int(m.group(1)) * int(m.group(2))
        if t["answer"] != exp or t.get("unit") != "см²":
            fail(f"geometry: area неверен {text} answer={t['answer']}, верно {exp}")
    elif t["subtype"] == "side":
        m = re.match(r"^Периметр квадрата (\d+) см\.", text)
        if m:
            exp = int(m.group(1)) // 4
        else:
            m = re.match(r"^Площадь прямоугольника (\d+) см², длина (\d+) см\.", text)
            if m:
                exp = int(m.group(1)) // int(m.group(2))
                assert int(m.group(1)) % int(m.group(2)) == 0, text
            else:
                m = re.match(r"^Периметр прямоугольника (\d+) см, длина (\d+) см\.", text)
                exp = int(m.group(1)) // 2 - int(m.group(2))
        if t["answer"] != exp or t.get("unit") != "см":
            fail(f"geometry: side неверен {text} answer={t['answer']}, верно {exp}")


