# Тема 2: сложение/вычитание (3 уровня)
for level in ["easy", "medium", "hard"]:
    tasks = json.loads(ctx.eval(f"__gen('addsub','{level}',{N})"))
    for t in tasks:
        check_common(t, "addsub")
        check_arith(t, "addsub")
        m = re.match(r"^(\d+) ([+−]) (\d+) = \?$", t["text"])
        a, op, b = int(m.group(1)), m.group(2), int(m.group(3))
        res = a + b if op == "+" else a - b
        if res < 0:
            fail(f"addsub {level}: отрицательный результат {t['text']}")
        if level in ("easy", "medium") and max(a, b, res) > 100:
            fail(f"addsub {level}: за пределами 100: {t['text']}")
        if level == "hard" and max(a, b, res) > 1000:
            fail(f"addsub hard: за пределами 1000: {t['text']}")
        if level == "easy":
            if op == "+" and (a % 10) + (b % 10) >= 10:
                fail(f"addsub easy: переход через десяток {t['text']}")
            if op == "−" and (a % 10) < (b % 10):
                fail(f"addsub easy: переход через десяток {t['text']}")
        subtypes_seen.setdefault(("addsub", level), set()).add(t["subtype"])

# Тема 3: порядок действий (3 уровня)
for level in ["easy", "medium", "hard"]:
    tasks = json.loads(ctx.eval(f"__gen('order','{level}',{N})"))
    for t in tasks:
        check_common(t, "order")
        check_arith(t, "order")
        check_mul_limit(t["text"], "order")
        if "1)" not in t["explanation"]:
            fail(f"order: нет пошагового пояснения: {t['text']}")
        text = t["text"]
        has_paren = "(" in text
        n_mul = len(re.findall(r"×", text))
        if level == "easy" and (has_paren or n_mul != 1 or "÷" in text):
            fail(f"order easy: только 2 действия без скобок ожидались: {text}")
        if level == "medium" and not (has_paren or "÷" in text):
            fail(f"order medium: скобки или деление ожидались: {text}")
        if level == "hard" and n_mul != 2:
            fail(f"order hard: 3 действия ожидались: {text}")
        subtypes_seen.setdefault(("order", level), set()).add(t["subtype"])

# Тема 4: длина (3 уровня)
for level in ["easy", "medium", "hard"]:
    tasks = json.loads(ctx.eval(f"__gen('length','{level}',{N})"))
    for t in tasks:
        check_common(t, "length")
        check_mul_limit(t["text"], "length")
        if level == "easy":
            if t["subtype"] != "convert":
                fail(f"length easy: только convert ожидался: {t['text']}")
            check_units_convert(t, LEN, "length")
            # Только соседние единицы с шагом 10
            m = re.match(r"^(\d+) (\S+) = _ (\?|\S+)$", t["text"])
            u_from = m.group(2)
            u_to = t.get("answerUnit") or m.group(3)
            if LEN[u_from] // LEN[u_to] != 10:
                fail(f"length easy: не шаг 10: {t['text']}")
        elif t["subtype"] == "convert":
            # В модуле длины выпадающий список единиц убран: единица ответа
            # всегда зафиксирована в условии
            if "unitOptions" in t:
                fail(f"length: convert с unitOptions недопустим: {t['text']}")
            if not t.get("unit"):
                fail(f"length: convert без зафиксированной единицы: {t['text']}")
            check_units_convert(t, LEN, "length")
        elif t["subtype"] == "compare":
            check_units_compare(t, LEN, "length")
        else:
            if level != "hard":
                fail(f"length {level}: неожиданный calc: {t['text']}")
            check_units_calc(t, LEN, "length")
        subtypes_seen.setdefault(("length", level), set()).add(t["subtype"])

# Тема 5: время (3 уровня)
for level in ["easy", "medium", "hard"]:
    tasks = json.loads(ctx.eval(f"__gen('time','{level}',{N})"))
    for t in tasks:
        check_common(t, "time")
        check_mul_limit(t["text"], "time")
        if t["subtype"] == "clock":
            check_clock(t, level)
        elif t["subtype"] == "convert":
            if re.match(r"^\d+ \S+ \d+ \S+ = _ \S+$", t["text"]):
                # Составной перевод — только сложный уровень
                if level != "hard":
                    fail(f"time {level}: составной convert не ожидался: {t['text']}")
                check_time_composite(t)
            else:
                check_units_convert(t, TIME, "time")
                if level == "easy":
                    m = re.match(r"^(\d+) (\S+) = _ (\?|\S+)$", t["text"])
                    if m.group(2) != "мин" or (t.get("answerUnit") or m.group(3)) != "с":
                        fail(f"time easy: только мин↔с ожидались: {t['text']}")
        else:
            if level != "medium":
                fail(f"time {level}: compare только на среднем уровне: {t['text']}")
            check_units_compare(t, TIME, "time")
        subtypes_seen.setdefault(("time", level), set()).add(t["subtype"])

